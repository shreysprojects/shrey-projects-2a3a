# Copy this file to ".env" and adjust for the provider you use.
# Never commit the real .env file.

# Model provider: local | mock | openai | anthropic | google
#   local  (DEFAULT) — self-hosted OpenAI-compatible server (Ollama). No key, no cloud.
#   mock            — offline placeholder output, no key (for testing/demo only).
#   openai/anthropic/google — cloud APIs (need the matching key below).
MODEL_PROVIDER=local

# --- local provider settings (used when MODEL_PROVIDER=local) ---
# Needs a local server running. Easiest is Ollama:
#   1) install Ollama   2) run:  ollama pull phi4-mini
# The Ollama server then listens on http://localhost:11434 automatically.
LOCAL_MODEL=phi4-mini
# LOCAL_BASE_URL=http://localhost:11434/v1   # Ollama default; vLLM=:8000/v1, LM Studio=:1234/v1

# Optional per-tool model overrides (each falls back to LOCAL_MODEL if unset).
# CLEANUP_MODEL     — model for 2A (cleanup). It can run smaller/faster than 3A.
# TRANSLATION_MODEL — model for 3A (translation check). 3A also runs a deterministic
#                     safety gate (src/safety_gate.py) that can only make verdicts
#                     stricter, which is what makes a small model safe to use here.
# CLEANUP_MODEL=granite3.3:2b
# TRANSLATION_MODEL=granite3.3:2b

# --- cloud provider keys (only needed if MODEL_PROVIDER is openai/anthropic/google) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional: override the default model per cloud provider.
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-6
# GOOGLE_MODEL=gemini-1.5-flash
